AUTH_TRUST_HOST=true

# Optional. Without it the AI panel shows "AI unavailable" and everything else works.
ANTHROPIC_API_KEY=""

# Seed login password for every seeded user (dev only). Users are listed in prisma/seed.ts.
SEED_PASSWORD="Plotworks-dev-2026"
