# Owner connection: used by Prisma migrate and the seed script.
DATABASE_URL="postgresql://plotworks:plotworks@localhost:5432/plotworks"
# Runtime connection: a NON-owner role so Postgres RLS is enforced on every query.
# Created by prisma/sql/001_rls_and_integrity.sql (change the password there for real deployments).
APP_DATABASE_URL="postgresql://plotworks_app:plotworks_app_dev@localhost:5432/plotworks"

